LUNA_TELEGRAM_TOKEN=
LUNA_TELEGRAM_CHAT_ID=
LUNA_HEALTHCHECK_URL=
# V4 forward collector backup (docker compose): host directory mounted at /backup in the
# `collector` container (e.g. a OneDrive/Google Drive sync folder, external disk, rclone mount).
# Empty = no backup: collection continues, collector-health/dashboard show a backup warning.
# The directory must contain an empty marker file .luna-backup-target (see docs/RUNBOOK.md §13).
# Without docker, set LUNA_FORWARD_BACKUP_DIR to the directory instead.
LUNA_FORWARD_BACKUP_HOST_DIR=
